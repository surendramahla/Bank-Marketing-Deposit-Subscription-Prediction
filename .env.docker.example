# ============================================================
# BankAI Pro — Docker Environment Variables Template
# ============================================================
# Usage: cp .env.docker.example .env
#        then edit .env with your values
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=bankai_db
POSTGRES_USER=bankai_user
POSTGRES_PASSWORD=bankai_pass_change_in_production

# ── JWT (Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_64_char_random_secret_string_for_access_tokens
JWT_REFRESH_SECRET=replace_with_another_64_char_random_string_for_refresh

# ── LLM Configuration ─────────────────────────────────────────
# Choose your LLM provider: gemini (free) or openai
LLM_PROVIDER=gemini

# Gemini (free tier): https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (paid): https://platform.openai.com
OPENAI_API_KEY=
