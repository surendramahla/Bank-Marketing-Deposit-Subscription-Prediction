# ============================================================
# BankAI Pro - Backend Environment Variables
# ============================================================
# Copy: cp .env.example .env  and fill in your values
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── PostgreSQL Database ───────────────────────────────────────
# Option A: Connection string (preferred for hosted DBs)
DATABASE_URL=postgresql://bankai_user:bankai_pass@localhost:5432/bankai_db

# Option B: Individual fields (used if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bankai_db
DB_USER=bankai_user
DB_PASSWORD=bankai_pass

# ── JWT Authentication ────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_string_for_access_tokens
JWT_REFRESH_SECRET=replace_with_64_char_random_string_for_refresh_tokens
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Python ML Service ─────────────────────────────────────────
# Where the FastAPI service runs (Phase 1)
ML_SERVICE_URL=http://localhost:8000

# ── File Uploads ──────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=32
UPLOAD_DIR=./uploads

# ── CORS ─────────────────────────────────────────────────────
# React frontend origin
FRONTEND_URL=http://localhost:3000

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
