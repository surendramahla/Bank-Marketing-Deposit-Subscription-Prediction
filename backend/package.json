{
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "name": "bankai-pro-backend",
  "version": "1.0.0",
  "description": "BankAI Pro - Node.js + Express API Gateway Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/db/seed.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "pg": "^8.12.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "form-data": "^4.0.0",
    "csv-parser": "^3.0.0",
    "winston": "^3.13.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
