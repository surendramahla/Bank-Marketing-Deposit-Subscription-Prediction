# ============================================================
# BankAI Pro - ML Service Environment Variables
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your API keys
#   3. Never commit .env to Git!
# ============================================================

# ── LLM Configuration ────────────────────────────────────────
# Choose your LLM provider: "gemini" (default, free tier) or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (get free at https://aistudio.google.com)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# ── Model Selection ───────────────────────────────────────────
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o

# ── App Configuration ─────────────────────────────────────────
DEBUG=false

# ── RAG Configuration ─────────────────────────────────────────
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3

# ── LangSmith Tracing (optional, for debugging LangChain) ────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here

# ── CORS Origins ──────────────────────────────────────────────
# Comma-separated list of allowed origins
# ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5000"]
